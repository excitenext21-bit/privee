# Hostinger Apache & LiteSpeed Configuration for Design Privée
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle Authorization Header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route API endpoints directly to PHP backend bridge for Hostinger Shared Web Hosting
  RewriteRule ^api/site-data/?$ api.php?action=site-data [QSA,L]
  RewriteRule ^api/upload/?$ api.php?action=upload [QSA,L]
  RewriteRule ^api/db-sync/?$ api.php [QSA,L]
  RewriteRule ^api/contact-submissions/?$ api.php?action=enquiry [QSA,L]
  RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

  # Allow direct access to existing files and directories (including /uploads/...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other frontend requests to index.html for Single Page App routing
  RewriteRule ^ index.html [L]
</IfModule>

# Enable GZIP Compression for fast loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Security & Cache Control Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Cache static assets for 1 year
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Prevent caching for API calls so live updates show up instantly
  <FilesMatch "api\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Block access to hidden files (.env, .git, .htaccess)
<FilesMatch "^\.">
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Block access to sensitive database dumps, logs, and config files
<FilesMatch "\.(sql|log|ini|sh|bak|config|env|md)$">
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Block direct access to internal data and json storage
<IfModule mod_rewrite.c>
  RewriteRule ^(data|public/data)/.*\.json$ - [F,L]
</IfModule>
